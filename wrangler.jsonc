{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whatif-social-net",
  "main": "./worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whatif-production",
      "database_id": "a32176f4-a00b-4a39-a306-9a72ad434c19",
      "preview_database_id": "whatif-local",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
